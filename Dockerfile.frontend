FROM node:22-slim

WORKDIR /app

# Install dependencies first (layer caching)
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install

# Copy frontend source
COPY frontend/ ./

EXPOSE 5173
# --host makes Vite bind to 0.0.0.0, required inside Docker
CMD ["npm", "run", "dev", "--", "--host"]
